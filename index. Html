  <style>
    :root { --gold:#d7b56d; --gold2:#f3dc9b; --black:#090909; --panel:#151515; --muted:#c7c1b5; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--black); color:#fff; font-family:Arial,Helvetica,sans-serif; line-height:1.55; }
    a { color:inherit; text-decoration:none; }
    .topbar { padding:10px 5%; text-align:center; background:#211b0e; color:var(--gold2); font-size:13px; letter-spacing:.4px; }
    header { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:20px 5%; border-bottom:1px solid #302716; position:sticky; top:0; z-index:10; background:rgba(9,9,9,.96); }
    .brand { font-weight:800; letter-spacing:1.5px; font-size:20px; color:var(--gold2); }
    .brand small { display:block; color:#fff; font-size:10px; letter-spacing:3px; font-weight:500; margin-top:2px; }
    nav { display:flex; gap:20px; align-items:center; font-size:14px; }
    nav a:hover { color:var(--gold2); }
    .btn { display:inline-block; background:linear-gradient(135deg,var(--gold2),var(--gold)); color:#111; padding:12px 18px; border-radius:5px; font-weight:700; border:0; cursor:pointer; }
    .btn.outline { color:var(--gold2); background:transparent; border:1px solid var(--gold); }
    .hero { min-height:470px; padding:75px 6%; display:grid; grid-template-columns:1.1fr .9fr; gap:30px; align-items:center; background:radial-gradient(ellipse at 80% 45%,#3a2d16 0%,#17130c 28%,#090909 67%); }
    .eyebrow { color:var(--gold2); text-transform:uppercase; letter-spacing:3px; font-size:12px; font-weight:bold; }
    h1 { font-size:clamp(36px,5vw,62px); line-height:1.08; margin:14px 0 18px; }
    h1 span { color:var(--gold2); }
    .hero p { color:var(--muted); max-width:540px; }
    .hero-art { min-height:280px; display:flex; align-items:center; justify-content:center; }
    .hero-art img { width:100%; max-width:460px; border-radius:12px; object-fit:cover; border:1px solid #6f582c; box-shadow:0 20px 60px #000; }
    section { padding:60px 6%; }
    .section-head { text-align:center; margin-bottom:30px; }
    .section-head h2 { font-size:32px; margin:8px 0; }
    .section-head p { color:var(--muted); margin:0 auto; max-width:620px; }
    .categories { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .category { border:1px solid #3c301a; border-radius:10px; padding:24px; background:linear-gradient(145deg,#171717,#0e0e0e); }
    .category .icon { font-size:30px; }
    .category h3 { color:var(--gold2); margin:8px 0; }
    .category p { color:var(--muted); font-size:14px; margin-bottom:0; }
    .products { background:#101010; }
    .product-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
    .product { overflow:hidden; background:#181818; border:1px solid #332919; border-radius:10px; }
    .product img { width:100%; height:210px; object-fit:cover; display:block; background:#252525; }
    .product-info { padding:17px; }
    .product-info h3 { margin:0 0 5px; }
    .product-info p { margin:0 0 12px; color:var(--muted); font-size:14px; }
    .price { color:var(--gold2); font-size:19px; font-weight:800; margin-bottom:14px; }
    .product .btn { width:100%; text-align:center; padding:10px; }
    .note { color:#a9a39a; font-size:12px; text-align:center; margin-top:18px; }
    .banner { display:flex; justify-content:space-between; align-items:center; gap:25px; background:linear-gradient(100deg,#2d2413,#15120b); border:1px solid #5a4726; padding:30px; border-radius:12px; }
    .banner h2 { margin:0 0 7px; color:var(--gold2); }
    .banner p { margin:0; color:var(--muted); }
    .contact { display:grid; grid-template-columns:1fr 1fr; gap:25px; }
    .contact-card { background:var(--panel); border:1px solid #332919; border-radius:10px; padding:25px; }
    .contact-card h3 { color:var(--gold2); margin-top:0; }
    .contact-card p { color:var(--muted); }
    footer { padding:25px 6%; border-top:1px solid #302716; text-align:center; color:#aaa; font-size:13px; }
    .float-wa { position:fixed; right:18px; bottom:18px; z-index:20; background:#25D366; color:#fff; border-radius:40px; padding:13px 17px; font-weight:800; box-shadow:0 5px 20px #0008; }
    @media(max-width:760px) {
      header { flex-wrap:wrap; padding:16px 5%; }
      nav { width:100%; justify-content:space-between; gap:8px; font-size:12px; }
      .hero { grid-template-columns:1fr; padding:55px 6%; }
      .hero-art { min-height:180px; }
      .categories,.product-grid,.contact { grid-template-columns:1fr; }
      .product img { height:240px; }
      .banner { flex-direction:column; align-items:flex-start; }
      section { padding:45px 5%; }
    }
  </style>
</head>
